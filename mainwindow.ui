       <item>
        <widget class="QWidget" name="leftMenuWidget" native="true">
         <property name="styleSheet">
          <string notr="true">/* 基础状态 */
QToolButton#processToolButton,
QToolButton#aiChatToolButton,
QToolButton#settingToolButton,
QToolButton#collapseToolButton {
    qproperty-iconSize: 16px;
    border: none;
    padding:6px 12px;
    background: transparent;
    
}

/* Hover &amp; Checked */
QToolButton#processToolButton:hover,
QToolButton#aiChatToolButton:hover,
QToolButton#settingToolButton:hover,
QToolButton#collapseToolButton:hover,
QToolButton#processToolButton:checked,
QToolButton#aiChatToolButton:checked,
QToolButton#settingToolButton:checked,
QToolButton#collapseToolButton:checked {
    background-color: #ece9e9;
}

/* 折叠状态 */
QWidget#leftMenuWidget[expanded=&quot;false&quot;] QToolButton#processToolButton,
QWidget#leftMenuWidget[expanded=&quot;false&quot;] QToolButton#aiChatToolButton,
QWidget#leftMenuWidget[expanded=&quot;false&quot;] QToolButton#settingToolButton,
QWidget#leftMenuWidget[expanded=&quot;false&quot;] QToolButton#collapseToolButton {
    padding: 6px 2px;
}

/* 展开状态 */
QWidget#leftMenuWidget[expanded=&quot;true&quot;] {
 }

/* ✅ 使用 qproperty-spacing 强制生效 */
QWidget#leftMenuWidget[expanded=&quot;true&quot;] QToolButton#processToolButton,
QWidget#leftMenuWidget[expanded=&quot;true&quot;] QToolButton#aiChatToolButton,
QWidget#leftMenuWidget[expanded=&quot;true&quot;] QToolButton#settingToolButton,
QWidget#leftMenuWidget[expanded=&quot;true&quot;] QToolButton#collapseToolButton {
    padding: 6px 12px;
}</string>
