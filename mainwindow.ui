      <property name="styleSheet">
       <string notr="true">/* 基础状态 */
QToolButton#processToolButton,
QToolButton#settingToolButton,
QToolButton#collapseToolButton {
    qproperty-iconSize: 16px;
    border: none;
	padding:6px 12px;
    background: transparent;
    
}

/* Hover &amp; Checked */
QToolButton#processToolButton:hover,
QToolButton#settingToolButton:hover,
QToolButton#collapseToolButton:hover,
QToolButton#processToolButton:checked,
QToolButton#settingToolButton:checked,
QToolButton#collapseToolButton:checked {
    background-color: #ece9e9;
	padding:6px 12px;
}

/* 折叠状态 */
QWidget#leftMenuWidget[expanded=&quot;false&quot;] {
  padding:5px;
}

QWidget#leftMenuWidget[expanded=&quot;false&quot;] QToolButton#processToolButton,
QWidget#leftMenuWidget[expanded=&quot;false&quot;] QToolButton#settingToolButton {
    
}

/* 展开状态 */
QWidget#leftMenuWidget[expanded=&quot;true&quot;] {
 }

/* ✅ 使用 qproperty-spacing 强制生效 */
